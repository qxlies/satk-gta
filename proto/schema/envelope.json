{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://satk.local/saap/1/envelope.json",
  "title": "SAAP/1 envelope",
  "$defs": {
    "request": {
      "type": "object",
      "properties": {
        "saap": {
          "const": 1
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "method": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "params": {
          "type": "object"
        }
      },
      "required": [
        "saap",
        "id",
        "method"
      ]
    },
    "response": {
      "type": "object",
      "properties": {
        "saap": {
          "const": 1
        },
        "id": {
          "type": "string",
          "maxLength": 64
        },
        "ok": {
          "type": "boolean"
        },
        "result": {
          "type": "object"
        },
        "error": {
          "$ref": "common.json#/$defs/Error"
        },
        "meta": {
          "$ref": "common.json#/$defs/Meta"
        }
      },
      "required": [
        "saap",
        "id",
        "ok"
      ],
      "oneOf": [
        {
          "properties": {
            "ok": {
              "const": true
            }
          },
          "required": [
            "result"
          ]
        },
        {
          "properties": {
            "ok": {
              "const": false
            }
          },
          "required": [
            "error"
          ]
        }
      ]
    }
  }
}
