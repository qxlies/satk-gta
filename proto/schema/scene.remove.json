{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://satk.local/saap/1/scene.remove.json",
  "title": "scene.remove",
  "description": "Remove entities by handle.",
  "x-saap": {
    "method": "scene.remove",
    "capability": "view",
    "since": 1
  },
  "$defs": {
    "params": {
      "type": "object",
      "properties": {
        "handle": {
          "type": "string",
          "pattern": "^@?[A-Za-z0-9_.-]{1,48}$"
        },
        "handles": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^@?[A-Za-z0-9_.-]{1,48}$"
          },
          "minItems": 1,
          "maxItems": 256
        }
      },
      "anyOf": [
        {
          "required": [
            "handle"
          ]
        },
        {
          "required": [
            "handles"
          ]
        }
      ]
    },
    "result": {
      "type": "object",
      "properties": {
        "removed": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "left": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "removed"
      ]
    }
  }
}
