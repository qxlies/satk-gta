{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://satk.local/saap/1/author.methods.json",
  "title": "author.methods",
  "x-saap": {
    "method": "author.methods",
    "capability": "author",
    "since": 1
  },
  "$defs": {
    "params": {
      "type": "object",
      "properties": {
        "query": {
          "type": "string",
          "maxLength": 64
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        }
      },
      "additionalProperties": false
    },
    "result": {
      "type": "object",
      "properties": {
        "methods": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "doc": {
                "type": "string"
              },
              "readonly": {
                "type": "boolean"
              }
            },
            "required": [
              "name"
            ]
          }
        },
        "total": {
          "type": "integer",
          "minimum": 0
        },
        "errors": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "methods",
        "total"
      ]
    }
  }
}
