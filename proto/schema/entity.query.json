{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://satk.local/saap/1/entity.query.json",
  "title": "entity.query",
  "x-saap": {
    "method": "entity.query",
    "capability": "entity.query",
    "since": 1
  },
  "$defs": {
    "params": {
      "type": "object",
      "properties": {
        "center": {
          "$ref": "common.json#/$defs/Vec3"
        },
        "r": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 3000
        },
        "kinds": {
          "type": "array",
          "items": {
            "$ref": "common.json#/$defs/EntityKind"
          }
        },
        "model": {
          "type": "integer"
        },
        "include_lod": {
          "type": "boolean"
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 256
        },
        "cursor": {
          "type": "string"
        }
      },
      "required": [
        "center",
        "r"
      ]
    },
    "result": {
      "type": "object",
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "$ref": "common.json#/$defs/EntityRef"
          }
        },
        "next": {
          "type": [
            "string",
            "null"
          ]
        },
        "total": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "items"
      ]
    }
  }
}
