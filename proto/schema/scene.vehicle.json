{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://satk.local/saap/1/scene.vehicle.json",
  "title": "scene.vehicle",
  "description": "Place a vehicle: frame hierarchy, wheels from its IDE entry, carcols paint, dirt, lamps, part states.",
  "x-saap": {
    "method": "scene.vehicle",
    "capability": "view",
    "since": 1
  },
  "$defs": {
    "params": {
      "type": "object",
      "properties": {
        "model": {
          "type": [
            "integer",
            "string"
          ],
          "minLength": 1,
          "description": "game model id or name"
        },
        "dff": {
          "$ref": "common.json#/$defs/Path",
          "description": "absolute path of a file (read only)"
        },
        "txd": {
          "oneOf": [
            {
              "$ref": "common.json#/$defs/Path",
              "description": "absolute path of a file (read only)"
            },
            {
              "type": "array",
              "items": {
                "$ref": "common.json#/$defs/Path",
                "description": "absolute path of a file (read only)"
              },
              "minItems": 1,
              "maxItems": 8
            }
          ],
          "description": "texture dictionaries, searched in order before the game's"
        },
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]{1,48}$",
          "description": "handle chosen by the client; placing again with the same id replaces that entity"
        },
        "pos": {
          "$ref": "common.json#/$defs/Vec3"
        },
        "rot": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 3,
          "maxItems": 4,
          "description": "[rx, ry, rz] degrees (X, then Y, then Z about world axes) or a quaternion [x, y, z, w]"
        },
        "heading": {
          "type": "number",
          "description": "degrees about Z, counter-clockwise seen from above (GTA heading)"
        },
        "ground": {
          "type": "boolean",
          "description": "drop onto the collision below pos (lowest point on the ground)"
        },
        "watch": {
          "type": "boolean",
          "description": "reload when the files change (polled, about 0.5 s)"
        },
        "colors": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "items": {
            "oneOf": [
              {
                "type": "integer",
                "minimum": 0,
                "maximum": 255
              },
              {
                "type": "string",
                "pattern": "^#[0-9a-fA-F]{6}$"
              }
            ]
          },
          "description": "paint slots 1-4: carcols.dat indices or #rrggbb"
        },
        "dirt": {
          "type": "integer",
          "minimum": 0,
          "maximum": 15
        },
        "lights": {
          "type": "boolean"
        },
        "parts": {
          "type": "object",
          "additionalProperties": {
            "enum": [
              "ok",
              "dam",
              "off"
            ]
          },
          "description": "part (door_lf, bonnet, bump_front, ...) -> ok | dam | off"
        },
        "wheels": {
          "type": "object",
          "properties": {
            "model": {
              "type": [
                "integer",
                "string"
              ],
              "minLength": 1,
              "description": "game model id or name"
            },
            "scale": {
              "oneOf": [
                {
                  "type": "number",
                  "exclusiveMinimum": 0,
                  "maximum": 10
                },
                {
                  "type": "array",
                  "items": {
                    "type": "number",
                    "exclusiveMinimum": 0,
                    "maximum": 10
                  },
                  "minItems": 2,
                  "maxItems": 2
                }
              ]
            }
          }
        }
      },
      "required": [
        "pos"
      ],
      "anyOf": [
        {
          "required": [
            "dff"
          ]
        },
        {
          "required": [
            "model"
          ]
        }
      ]
    },
    "result": {
      "type": "object",
      "properties": {
        "handle": {
          "type": "string",
          "minLength": 1
        },
        "ref": {
          "type": "string",
          "pattern": "^@"
        },
        "entity": {
          "$ref": "common.json#/$defs/EntityRef"
        },
        "replaced": {
          "type": "boolean"
        },
        "stats": {
          "type": "object",
          "properties": {
            "atomics": {
              "type": "integer",
              "minimum": 0
            },
            "tris": {
              "type": "integer",
              "minimum": 0
            },
            "textures": {
              "type": "integer",
              "minimum": 0
            },
            "missing_textures": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "bounds": {
              "type": "array",
              "items": {
                "$ref": "common.json#/$defs/Vec3"
              },
              "minItems": 2,
              "maxItems": 2
            }
          }
        },
        "grounded": {
          "type": "boolean"
        },
        "warn": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "load_ms": {
          "type": "number",
          "minimum": 0
        },
        "vehicle": {
          "type": "object",
          "properties": {
            "type": {
              "type": "string"
            },
            "txd": {
              "type": "string"
            },
            "wheels": {
              "type": "object",
              "properties": {
                "from": {
                  "type": "string"
                },
                "scale": {
                  "type": "array",
                  "items": {
                    "type": "number"
                  },
                  "minItems": 2,
                  "maxItems": 2
                },
                "count": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            },
            "colors": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "slot": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 4
                  },
                  "index": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "rgb": {
                    "type": "string",
                    "pattern": "^#[0-9a-f]{6}$"
                  }
                },
                "required": [
                  "slot",
                  "rgb"
                ]
              }
            },
            "dirt": {
              "type": "integer",
              "minimum": 0,
              "maximum": 15
            },
            "lights": {
              "type": "boolean"
            },
            "parts": {
              "type": "object",
              "additionalProperties": {
                "enum": [
                  "ok",
                  "dam",
                  "off"
                ]
              }
            },
            "materials": {
              "type": "object"
            }
          }
        }
      },
      "required": [
        "handle",
        "ref",
        "entity",
        "vehicle"
      ]
    }
  }
}
