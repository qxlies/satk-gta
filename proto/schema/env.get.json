{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://satk.local/saap/1/env.get.json",
  "title": "env.get",
  "x-saap": {
    "method": "env.get",
    "capability": "env",
    "since": 1
  },
  "$defs": {
    "params": {
      "type": "object"
    },
    "result": {
      "allOf": [
        {
          "$ref": "common.json#/$defs/Env"
        },
        {
          "type": "object",
          "properties": {
            "weathers": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "integer"
                  },
                  "name": {
                    "type": "string"
                  }
                },
                "required": [
                  "id"
                ]
              }
            }
          },
          "required": [
            "time",
            "weather"
          ]
        }
      ]
    }
  }
}
