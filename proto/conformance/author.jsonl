{"id":"author.methods","caps":["author"],"doc":"author.methods lists the plug-in methods","steps":[{"call":"author.methods","expect":{"ok":true,"result":{"methods":{"$contains":{"name":"mesh.primitive"}},"total":{"$gte":4}}}},{"call":"author.methods","params":{"query":"primitive"},"expect":{"ok":true,"result":{"methods":{"$contains":{"name":"mesh.primitive"}}}}}]}
{"id":"author.call.primitive","caps":["author"],"doc":"a primitive reports its stats; scene.info sees it","steps":[{"call":"author.call","params":{"method":"scene.clear","params":{"match":"conf_*"}},"expect":{"ok":true,"result":{"method":"scene.clear"}}},{"call":"author.call","params":{"method":"mesh.primitive","params":{"kind":"cube","name":"conf_cube","size":2}},"expect":{"ok":true,"result":{"method":"mesh.primitive","n":{"$gte":1},"changed":{"$contains":"conf_cube"},"stats":{"objects":{"conf_cube":{"tris":12,"verts":8,"dims":{"$approx":[2,2,2],"tol":0.01}}}},"ms":{"$type":"number"}}}},{"call":"author.call","params":{"method":"scene.info","params":{"match":"conf_cube"}},"expect":{"ok":true,"result":{"result":{"total":1,"objects":{"$contains":{"name":"conf_cube","tris":12}}}}}}]}
{"id":"author.call.density","caps":["author"],"doc":"round primitives need an explicit segment count","steps":[{"call":"author.call","params":{"method":"scene.clear","params":{"match":"conf_*"}},"expect":{"ok":true}},{"call":"author.call","params":{"method":"mesh.primitive","params":{"kind":"cylinder","name":"conf_post"}},"expect":{"ok":false,"error":"BAD_PARAMS"}},{"call":"author.call","params":{"method":"mesh.primitive","params":{"kind":"cylinder","name":"conf_post","segments":12,"radius":0.3,"depth":1}},"expect":{"ok":true,"result":{"stats":{"objects":{"conf_post":{"tris":44,"verts":24}}}}}}]}
{"id":"author.call.unknown_method","caps":["author"],"doc":"an unknown studio method is NOT_FOUND and the connection stays","steps":[{"call":"author.call","params":{"method":"no.such_method"},"expect":{"ok":false,"error":"NOT_FOUND"}},{"call":"ping","expect":{"ok":true}}]}
{"id":"author.call.error_keeps_session","caps":["author"],"doc":"an exception inside a method is an error envelope; the next call works","steps":[{"call":"author.call","params":{"method":"python","params":{"code":"raise ValueError('boom')"}},"expect":{"ok":false,"error":"BAD_PARAMS"}},{"call":"author.call","params":{"method":"scene.info"},"expect":{"ok":true,"result":{"method":"scene.info"}}},{"call":"author.call","params":{"method":"scene.clear","params":{"match":"conf_*"}},"expect":{"ok":true}}]}
{"id":"author.call.schema","caps":["author"],"doc":"author.call without a method fails validation","steps":[{"call":"author.call","params":{"params":{}},"invalid":true,"expect":{"ok":false,"error":"BAD_PARAMS"}},{"call":"author.call","params":{"method":"scene.info","snapshot":{"view":"3q","size":8}},"invalid":true,"expect":{"ok":false,"error":"BAD_PARAMS"}}]}
{"id":"author.call.batch","caps":["author"],"doc":"a batch runs its steps in order and reports each; a bad step name fails before anything runs","steps":[{"call":"author.call","params":{"method":"scene.clear","params":{"match":"conf_*"}},"expect":{"ok":true}},{"call":"author.call","params":{"method":"batch","params":{"steps":[{"method":"mesh.primitive","params":{"kind":"cube","name":"conf_b1"}},{"method":"mesh.primitive","params":{"kind":"cube","name":"conf_b2"}}]}},"expect":{"ok":true,"result":{"method":"batch","steps":{"$contains":{"method":"mesh.primitive"}},"changed":{"$contains":"conf_b2"}}}},{"call":"author.call","params":{"method":"batch","params":{"steps":[{"method":"mesh.primitive","params":{"kind":"cube","name":"conf_b3"}},{"method":"no.such_method"}]}},"expect":{"ok":false,"error":"NOT_FOUND"}},{"call":"author.call","params":{"method":"scene.info","params":{"match":"conf_b*"}},"expect":{"ok":true,"result":{"result":{"total":2}}}},{"call":"author.call","params":{"method":"scene.clear","params":{"match":"conf_*"}},"expect":{"ok":true}}]}
