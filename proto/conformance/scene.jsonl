{"id":"scene.vehicle.model","caps":["view"],"doc":"a game vehicle by id: handle, @ref, vehicle details; listed, then removed (other entities stay)","steps":[{"call":"scene.vehicle","params":{"model":411,"pos":[2495.0,-1675.0,13.4],"heading":90,"dirt":2,"colors":[3,1],"id":"conf_car"},"expect":{"ok":true,"result":{"handle":"conf_car","ref":"@conf_car","entity":{"ref":"@conf_car","kind":"vehicle","model_id":411,"src":{"kind":"runtime","type":"scene","id":"conf_car"}},"vehicle":{"dirt":2,"colors":{"$len":2}},"stats":{"atomics":{"$gte":1}}}}},{"call":"scene.list","expect":{"ok":true,"result":{"items":{"$contains":{"handle":"conf_car","entity":{"kind":"vehicle"}}}}},"save":{"n":"result.total"}},{"call":"scene.remove","params":{"handle":"conf_car"},"expect":{"ok":true,"result":{"removed":["conf_car"]}}},{"call":"scene.list","expect":{"ok":true,"result":{"total":{"$lte":"${n}"}}}}]}
{"id":"scene.place.model","caps":["view"],"doc":"a map object by id; placing the same id again replaces it in place","steps":[{"call":"scene.place","params":{"model":1280,"pos":[2493.0,-1671.0,13.4],"id":"conf_bench"},"expect":{"ok":true,"result":{"handle":"conf_bench","entity":{"kind":"object","model_id":1280}}}},{"call":"scene.list","save":{"n":"result.total"}},{"call":"scene.place","params":{"model":1280,"pos":[2494.0,-1671.0,13.4],"heading":45,"id":"conf_bench"},"expect":{"ok":true,"result":{"handle":"conf_bench","replaced":true,"entity":{"pos":{"$approx":[2494.0,-1671.0,13.4],"tol":0.01}}}}},{"call":"scene.list","expect":{"ok":true,"result":{"total":"${n}"}}},{"call":"scene.remove","params":{"handles":["@conf_bench"]},"expect":{"ok":true,"result":{"removed":["conf_bench"]}}}]}
{"id":"scene.ped.default_pose","caps":["view"],"doc":"a game ped in the default idle stance","steps":[{"call":"scene.ped","params":{"model":105,"pos":[2497.5,-1673.0,13.4],"heading":180,"id":"conf_ped"},"expect":{"ok":true,"result":{"handle":"conf_ped","entity":{"kind":"ped"},"ped":{"anim":{"ifp":"ped","name":"idle_stance"}}}}},{"call":"scene.reload","params":{"handle":"conf_ped"},"expect":{"ok":true,"result":{"reloaded":[{"handle":"conf_ped","ok":true}],"failed":0}}},{"call":"scene.remove","params":{"handle":"conf_ped"},"expect":{"ok":true}}]}
{"id":"scene.capture.ids","caps":["view","capture","capture.ids"],"doc":"a placed vehicle is part of the ID layer and its legend","steps":[{"call":"scene.vehicle","params":{"model":411,"pos":[2495.0,-1675.0,13.4],"id":"conf_seen"},"expect":{"ok":true}},{"call":"capture","params":{"path_prefix":"${prefix}","w":320,"h":240,"pose":{"pos":[2495.0,-1688.0,19.0],"look":[2495.0,-1675.0,13.4],"fov_h_deg":70},"layers":["color","ids"]},"expect":{"ok":true,"result":{"ids_legend":{"$contains":{"entity":{"ref":"@conf_seen","kind":"vehicle"}}}}}},{"call":"scene.remove","params":{"handle":"conf_seen"},"expect":{"ok":true}}]}
{"id":"scene.missing_file","caps":["view"],"doc":"a DFF that does not exist is NOT_FOUND and nothing is placed","steps":[{"call":"scene.list","save":{"n":"result.total"}},{"call":"scene.place","params":{"dff":"${prefix}.dff","pos":[2493.0,-1671.0,13.4]},"expect":{"ok":false,"error":"NOT_FOUND"}},{"call":"scene.list","expect":{"ok":true,"result":{"total":"${n}"}}}]}
{"id":"scene.unknown_handle","caps":["view"],"doc":"unknown handles are NOT_FOUND; the connection stays","steps":[{"call":"scene.remove","params":{"handle":"no_such_handle_zz"},"expect":{"ok":false,"error":"NOT_FOUND"}},{"call":"scene.reload","params":{"handle":"no_such_handle_zz"},"expect":{"ok":false,"error":"NOT_FOUND"}},{"call":"ping","expect":{"ok":true}}]}
{"id":"scene.vehicle.unknown_part","caps":["view"],"doc":"an unknown part is BAD_PARAMS","steps":[{"call":"scene.vehicle","params":{"model":411,"pos":[2495.0,-1675.0,13.4],"parts":{"no_such_part":"dam"}},"expect":{"ok":false,"error":"BAD_PARAMS"}}]}
{"id":"scene.bad_params","caps":["view"],"doc":"schema violations are BAD_PARAMS","steps":[{"call":"scene.place","invalid":true,"params":{"model":1280},"expect":{"ok":false,"error":"BAD_PARAMS"}},{"call":"scene.vehicle","invalid":true,"params":{"model":411,"pos":[2495.0,-1675.0,13.4],"dirt":16},"expect":{"ok":false,"error":"BAD_PARAMS"}},{"call":"scene.place","invalid":true,"params":{"pos":[2493.0,-1671.0,13.4]},"expect":{"ok":false,"error":"BAD_PARAMS"}}]}
