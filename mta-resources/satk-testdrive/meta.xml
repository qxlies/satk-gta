    <info author="satk" name="satk-testdrive" version="1.0.0" type="script"
          description="satk in-game test drive: model loading, test spots, behaviour checks"/>

    <script src="shared.lua" type="shared"/>
    <script src="server.lua" type="server"/>
    <script src="client.lua" type="client"/>
    <script src="checks.lua" type="client"/>

    <export function="td" type="server"/>
    <export function="tdc" type="client"/>
</meta>
